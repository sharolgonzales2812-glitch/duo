# backend/.env.example — copiar a .env y completar valores reales

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-segura
DJANGO_SETTINGS_MODULE=config.settings.development

DB_NAME=skincaremaysha_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

ALLOWED_HOSTS=localhost,127.0.0.1

# JWT duración de tokens (en minutos / días)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Ruta base para archivos de media
MEDIA_ROOT=media/